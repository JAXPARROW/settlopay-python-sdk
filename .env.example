# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# Settlo has NO sandbox: sk_test_ keys also move real money.
SETTLO_API_KEY=
SETTLO_WEBHOOK_SECRET=

# Live smoke test (read-only unless the money-movement opt-in is also set)
SETTLO_RUN_LIVE=0
SETTLO_LIVE_PHONE=
SETTLO_ALLOW_MONEY_MOVEMENT=0
SETTLO_LIVE_AMOUNT=500
